# Salin parameter ini ke .env project semantic-bridge.
# JANGAN menimpa APP_KEY project yang sudah ada.
APP_NAME="SIAKADU Semantic Bridge"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8002

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=semantic_hub_db
DB_USERNAME=postgres
DB_PASSWORD="GANTI_DENGAN_PASSWORD_POSTGRESQL"

SYSTEM_A_DB_HOST=127.0.0.1
SYSTEM_A_DB_PORT=5432
SYSTEM_A_DB_DATABASE=pengajuan_akademik
SYSTEM_A_DB_USERNAME=postgres
SYSTEM_A_DB_PASSWORD="GANTI_DENGAN_PASSWORD_POSTGRESQL"

SYSTEM_B_DB_HOST=127.0.0.1
SYSTEM_B_DB_PORT=5432
SYSTEM_B_DB_DATABASE=siakadu_db
SYSTEM_B_DB_USERNAME=postgres
SYSTEM_B_DB_PASSWORD="GANTI_DENGAN_PASSWORD_POSTGRESQL"

CACHE_STORE=file
SESSION_DRIVER=file

# Buat token lokal acak panjang. Token ini bukan password login.
SEMANTIC_API_TOKEN="GANTI_DENGAN_TOKEN_ACAK_PANJANG"
