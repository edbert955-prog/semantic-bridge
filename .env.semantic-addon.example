# Tambahkan baris berikut ke .env project semantic-bridge; jangan timpa APP_KEY atau kredensial yang sudah ada.
SEMANTIC_GRAPH_BASE_URI=https://unila.ac.id/graph/
SEMANTIC_RESOURCE_BASE_URI=https://unila.ac.id/resource

# Default aman: RDF akan dibuat sebagai file lokal sampai Fuseki/reasoner dikonfigurasi.
FUSEKI_ENABLED=false
FUSEKI_QUERY_URL=http://127.0.0.1:3030/siakadu/query
FUSEKI_UPDATE_URL=http://127.0.0.1:3030/siakadu/update
FUSEKI_DATA_URL=http://127.0.0.1:3030/siakadu/data
FUSEKI_USERNAME=
FUSEKI_PASSWORD=
FUSEKI_TIMEOUT=10

# Reasoner opsional: requires JDK 21+, Maven, and a built JAR under semantic-reasoner/target.
SEMANTIC_REASONER_ENABLED=false
SEMANTIC_REASONER_JAR="D:/System_Semantic/semantic-bridge/semantic-reasoner/target/semantic-owl2rl-reasoner.jar"
SEMANTIC_JAVA_BINARY=java
SEMANTIC_REASONER_TIMEOUT=90
